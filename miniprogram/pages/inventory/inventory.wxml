<view class="container">
  <!-- Search Bar -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索商品名称..."
      placeholder-class="input-placeholder"
      value="{{searchValue}}"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
    />
    <view class="search-btn" bindtap="onSearch">
      <text>🔍</text>
    </view>
  </view>

  <!-- Inventory Count -->
  <view class="inventory-count text-sm text-muted mb-md" wx:if="{{products.length > 0}}">
    <text>共 {{products.length}} 条库存记录</text>
  </view>

  <!-- Product List -->
  <view class="product-list">
    <view
      class="product-card card"
      wx:for="{{products}}"
      wx:key="id"
    >
      <view class="product-info flex-row">
        <view class="product-thumb placeholder">
          <text>💎</text>
        </view>
        <view class="flex-1 product-detail">
          <text class="product-name font-bold">{{item.product_name}}</text>
          <text class="product-code text-sm text-muted">{{item.location_name || '未分配仓位'}}</text>
        </view>
        <view class="product-weight-info">
          <text class="weight-value">{{item.weight}}g</text>
          <text class="weight-label text-sm text-muted">库存克重</text>
        </view>
      </view>
    </view>

    <!-- Empty State -->
    <view class="empty-state" wx:if="{{!isLoading && products.length === 0}}">
      <text class="empty-icon">📦</text>
      <text class="empty-text text-muted">暂无库存数据</text>
    </view>

    <!-- Loading -->
    <view class="loading-more text-center text-muted" wx:if="{{isLoading}}">
      <text>加载中...</text>
    </view>
  </view>
</view>
