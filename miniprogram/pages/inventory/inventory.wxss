.search-bar {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: 36rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 64rpx;
}

.search-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.category-tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--card-bg);
  transition: all 0.2s;
}

.tab-item.active {
  background: var(--primary-color);
  color: #ffffff;
}

.product-card {
  padding: 20rpx;
}

.product-info {
  align-items: flex-start;
}

.product-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-thumb image {
  width: 100%;
  height: 100%;
}

.product-thumb.placeholder {
  background: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.product-detail {
  min-width: 0;
}

.product-name {
  display: block;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-code {
  display: block;
  margin-top: 4rpx;
}

.product-meta {
  gap: 24rpx;
}

.product-weight {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.product-stock {
  font-size: 24rpx;
  color: var(--success-color);
}

.product-stock.low {
  color: var(--danger-color);
}

.product-weight-info {
  flex-shrink: 0;
  text-align: right;
}

.weight-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.weight-label {
  display: block;
}

.inventory-count {
  padding-left: 8rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
}

.loading-more {
  padding: 24rpx 0;
  font-size: 24rpx;
}
