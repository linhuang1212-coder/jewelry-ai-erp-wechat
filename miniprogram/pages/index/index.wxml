<view class="container">
  <!-- Header -->
  <view class="header card">
    <view class="flex-row">
      <view class="avatar-wrap">
        <image class="avatar" src="/assets/icons/default-avatar.png" mode="aspectFill" />
      </view>
      <view class="flex-1 ml-md">
        <text class="text-lg font-bold">珠宝AI助手</text>
        <text class="text-sm text-muted mt-sm">欢迎回来，今天也是闪闪发光的一天</text>
      </view>
    </view>
  </view>

  <!-- Stats Cards -->
  <view class="stats-grid">
    <view class="stat-card card">
      <text class="stat-value">¥{{stats.todaySales}}</text>
      <text class="stat-label">今日销售额</text>
    </view>
    <view class="stat-card card">
      <text class="stat-value">{{stats.todayOrders}}</text>
      <text class="stat-label">今日订单</text>
    </view>
    <view class="stat-card card">
      <text class="stat-value gold-price">{{stats.avgGoldPrice}}</text>
      <text class="stat-label">今日均金价</text>
    </view>
    <view class="stat-card card">
      <text class="stat-value">{{stats.pendingTasks}}</text>
      <text class="stat-label">待结算单</text>
    </view>
  </view>

  <!-- Quick Actions -->
  <view class="section-title">
    <text class="text-lg font-bold">快捷操作</text>
  </view>
  <view class="actions-grid">
    <view
      class="action-card card"
      wx:for="{{quickActions}}"
      wx:key="title"
      bindtap="onActionTap"
      data-page="{{item.page}}"
    >
      <text class="action-icon">{{item.icon}}</text>
      <text class="action-title">{{item.title}}</text>
      <text class="action-desc text-sm text-muted">{{item.desc}}</text>
    </view>
  </view>
</view>
