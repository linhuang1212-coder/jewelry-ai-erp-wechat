.header {
  background: linear-gradient(135deg, #1a1a2e, #2d2d4e);
  color: #ffffff;
}

.header .text-muted {
  color: rgba(255, 255, 255, 0.7);
}

.avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(212, 165, 116, 0.6);
}

.avatar {
  width: 100%;
  height: 100%;
}

.ml-md {
  margin-left: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  text-align: center;
  padding: 28rpx 16rpx;
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary-dark);
  margin-bottom: 8rpx;
}

.gold-price {
  color: var(--primary-color);
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
}

.section-title {
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.actions-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.action-card {
  text-align: center;
  padding: 32rpx 16rpx;
  transition: transform 0.15s;
}

.action-card:active {
  transform: scale(0.96);
}

.action-icon {
  display: block;
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.action-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.action-desc {
  display: block;
}
