.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-color);
}

.chat-messages {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 0;
}

/* Suggestions */
.suggestions {
  padding: 24rpx 0;
}

.suggestions-title {
  display: block;
  margin-bottom: 16rpx;
}

.suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.suggestion-chip {
  background: var(--card-bg);
  border: 2rpx solid var(--border-color);
  border-radius: 32rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: var(--primary-color);
  transition: all 0.15s;
}

.suggestion-chip:active {
  background: var(--primary-color);
  color: #fff;
  border-color: var(--primary-color);
}

/* Messages */
.message-wrap {
  margin-bottom: 24rpx;
}

.message-wrap.user {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.message-wrap.assistant {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.message-bubble {
  max-width: 80%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  word-break: break-all;
  line-height: 1.6;
}

.message-bubble.user {
  background: linear-gradient(135deg, #d4a574, #c49060);
  color: #ffffff;
  border-bottom-right-radius: 6rpx;
}

.message-bubble.assistant {
  background: var(--card-bg);
  color: var(--text-primary);
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.message-text {
  font-size: 28rpx;
}

.message-time {
  margin-top: 6rpx;
  padding: 0 8rpx;
}

/* Typing Indicator */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 4rpx 0;
}

.typing-indicator .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--text-muted);
  animation: bounce 1.4s infinite ease-in-out;
}

.typing-indicator .dot:nth-child(1) { animation-delay: 0s; }
.typing-indicator .dot:nth-child(2) { animation-delay: 0.2s; }
.typing-indicator .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* Input Area */
.chat-input-area {
  background: var(--card-bg);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--border-color);
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  background: var(--bg-color);
  border-radius: 36rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  min-height: 36rpx;
}

.input-placeholder {
  color: var(--text-muted);
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  flex-shrink: 0;
}

.send-btn.active {
  background: linear-gradient(135deg, #d4a574, #c49060);
}

.send-icon {
  font-size: 32rpx;
  color: #ffffff;
}

.input-toolbar {
  display: flex;
  padding-top: 12rpx;
  gap: 24rpx;
}

.toolbar-btn {
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 4rpx 8rpx;
}

.toolbar-btn:active {
  color: var(--primary-color);
}
