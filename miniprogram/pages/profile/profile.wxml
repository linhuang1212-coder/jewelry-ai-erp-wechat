<view class="container">
  <!-- Profile Header -->
  <view class="profile-header card">
    <view class="flex-row">
      <view class="avatar-wrap">
        <image class="avatar" src="/assets/icons/default-avatar.png" mode="aspectFill" />
      </view>
      <view class="flex-1 user-info">
        <text class="text-lg font-bold">珠宝AI ERP</text>
        <text class="text-sm text-muted mt-sm">当前角色：{{userRole === 'manager' ? '管理员' : userRole === 'sales' ? '业务员' : userRole === 'finance' ? '财务' : '仓管'}}</text>
      </view>
    </view>
  </view>

  <!-- Role Switcher -->
  <view class="card">
    <view class="flex-row">
      <text class="menu-icon">👤</text>
      <view class="flex-1">
        <text class="menu-title">切换角色</text>
        <text class="menu-desc text-sm text-muted">不同角色有不同的AI权限</text>
      </view>
      <picker bindchange="onRoleChange" range="{{roles}}" range-key="label">
        <text class="role-picker">{{userRole === 'manager' ? '管理员' : userRole === 'sales' ? '业务员' : userRole === 'finance' ? '财务' : '仓管'}} ›</text>
      </picker>
    </view>
  </view>

  <!-- Menu List -->
  <view class="menu-list">
    <view
      class="menu-item card"
      wx:for="{{menuItems}}"
      wx:key="title"
      bindtap="onMenuTap"
      data-title="{{item.title}}"
    >
      <view class="flex-row">
        <text class="menu-icon">{{item.icon}}</text>
        <view class="flex-1">
          <text class="menu-title">{{item.title}}</text>
          <text class="menu-desc text-sm text-muted">{{item.desc}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- Version -->
  <view class="version text-center text-muted mt-lg">
    <text>珠宝AI ERP v1.0.0</text>
  </view>
</view>
