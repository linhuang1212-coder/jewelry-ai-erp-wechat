.profile-header {
  background: linear-gradient(135deg, #1a1a2e, #2d2d4e);
  color: #ffffff;
}

.profile-header .text-muted {
  color: rgba(255, 255, 255, 0.7);
}

.avatar-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(212, 165, 116, 0.6);
  margin-right: 24rpx;
}

.avatar {
  width: 100%;
  height: 100%;
}

.user-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.menu-list {
  margin-top: 8rpx;
}

.menu-item {
  margin-bottom: 2rpx;
  border-radius: 0;
  padding: 28rpx 24rpx;
}

.menu-item:first-child {
  border-radius: 16rpx 16rpx 0 0;
}

.menu-item:last-child {
  border-radius: 0 0 16rpx 16rpx;
  margin-bottom: 24rpx;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.menu-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
}

.menu-desc {
  display: block;
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-muted);
  margin-left: 12rpx;
}

.role-picker {
  color: var(--primary-color);
  font-size: 28rpx;
}

.version {
  font-size: 22rpx;
  padding-bottom: 40rpx;
}
